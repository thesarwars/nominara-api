{
  "name": "nominara-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-build-assets.mjs",
    "start": "node dist/src/main.js",
    "start:gateway": "node dist/src/gateway.js",
    "start:worker": "node dist/src/worker.js",
    "db:generate": "tsx src/db/generate.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:rollback": "tsx src/db/rollback.ts",
    "db:drift-check": "tsx src/db/drift-check.ts",
    "db:reset": "tsx src/db/reset.ts",
    "db:role-check": "tsx src/db/role-check.ts",
    "db:dev-credentials": "tsx src/db/dev-credentials.ts",
    "db:rls-generate": "tsx src/db/rls/generate.ts",
    "db:rls-check": "tsx src/db/rls/rls-check.ts",
    "db:schema-generate": "tsx src/db/schema/generate.ts",
    "db:schema-check": "tsx src/db/schema/schema-check.ts",
    "db:roundtrip-check": "tsx src/db/roundtrip-check.ts",
    "db:studio": "tsx src/db/studio.ts",
    "db:seed-demo": "tsx src/db/seed-demo.ts",
    "db:maintenance:run": "tsx src/workers/rollup/maintenance.ts",
    "db:maintenance:sweep": "tsx src/workers/rollup/retention.ts",
    "identity:sweep-unverified": "tsx src/workers/rollup/unverified-sweep.ts",
    "credits:verify": "tsx src/workers/rollup/credit-verify.ts",
    "credits:reconcile": "tsx src/workers/rollup/credit-reconcile.ts",
    "plan:set": "tsx src/workers/billing/plan-set.ts",
    "support:grant": "tsx src/workers/support/support-grant.ts grant",
    "support:revoke": "tsx src/workers/support/support-grant.ts revoke",
    "audit:verify": "tsx src/workers/rollup/audit-verify.ts",
    "audit:export": "tsx src/workers/rollup/audit-export.ts",
    "db:purge-check": "tsx src/db/purge-check.ts",
    "contracts:generate": "tsx src/contracts/generate.ts",
    "contracts:check": "tsx src/contracts/check.ts",
    "contracts:diff": "tsx src/contracts/diff.ts",
    "client:generate": "tsx src/contracts/client.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit src contracts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:isolation": "vitest run --config vitest.isolation.config.ts --exclude \"test/isolation/breakers/**\"",
    "test:isolation:breakers": "vitest run --config vitest.isolation.config.ts test/isolation/breakers"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-fastify": "11.2.1",
    "@nestjs/platform-socket.io": "11.2.1",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/websockets": "11.2.1",
    "@node-rs/argon2": "2.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@scalar/fastify-api-reference": "^1.66.1",
    "@simplewebauthn/server": "13.3.2",
    "@socket.io/redis-adapter": "8.3.0",
    "bullmq": "^6.2.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.0",
    "ioredis": "6.0.0",
    "jose": "6.2.9",
    "openid-client": "6.8.7",
    "pdfkit": "0.20.2",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "stripe": "23.0.0",
    "tldts": "7.4.11",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "11.2.1",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "26.2.0",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.21.0",
    "@typescript-eslint/parser": "8.67.0",
