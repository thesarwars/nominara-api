DATABASE_URL=postgres://nominara:nominara@localhost:5432/nominara

# STORY-010: the pooled connection, through pgBouncer in transaction mode
# (docker/pgbouncer/pgbouncer.ini) on port 6432. Application code (src/api,
# src/gateway, src/workers/*) uses THIS one. DATABASE_URL above (port 5432,
# direct to Postgres) stays the migration/DDL connection and never routes
# through the pooler — migrations need a real session-scoped connection for
# their own transactions, which a transaction-mode pool cannot provide.
DATABASE_URL_POOLED=postgres://nominara_app:nominara_app_dev_local@localhost:6432/nominara

# STORY-014 — WebAuthn relying party. Never hardcoded in app code; a
# credential minted against one environment's rpID/origin must fail
# verification against another's.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Nominara
WEBAUTHN_ORIGIN=http://localhost:3000

# STORY-014 — access token EdDSA (Ed25519) signing keypair, base64 DER
# (PKCS8 private / SPKI public), verified with `jose`'s jwtVerify. STORY-017
# owns rotation-with-overlap and production key management. The values below
# are an obvious, non-functional placeholder — never a real keypair checked
# into source control. Generate your own local dev pair with:
#   node -e "const {generateKeyPairSync}=require('node:crypto'); \
#     const {privateKey,publicKey}=generateKeyPairSync('ed25519'); \
#     console.log('AUTH_TOKEN_ED25519_PRIVATE_KEY='+privateKey.export({type:'pkcs8',format:'der'}).toString('base64')); \
#     console.log('AUTH_TOKEN_ED25519_PUBLIC_KEY='+publicKey.export({type:'spki',format:'der'}).toString('base64'));"
AUTH_TOKEN_ED25519_PRIVATE_KEY=REPLACE_WITH_YOUR_OWN_BASE64_DER_PKCS8_ED25519_PRIVATE_KEY
AUTH_TOKEN_ED25519_PUBLIC_KEY=REPLACE_WITH_YOUR_OWN_BASE64_DER_SPKI_ED25519_PUBLIC_KEY
