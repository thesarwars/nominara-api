# The API's own port. 4000, not 3000 — 3000 is the frontend's, and the two run
# side by side in development. The gateway is a SEPARATE process on
# GATEWAY_PORT (3001).
PORT=4000

DATABASE_URL=postgres://nominara:nominara@localhost:5432/nominara

# STORY-010: the pooled connection, through pgBouncer in transaction mode
# (docker/pgbouncer/pgbouncer.ini) on port 6432. Application code (src/api,
# src/gateway, src/workers/*) uses THIS one. DATABASE_URL above (port 5432,
# direct to Postgres) stays the migration/DDL connection and never routes
# through the pooler — migrations need a real session-scoped connection for
# their own transactions, which a transaction-mode pool cannot provide.
DATABASE_URL_POOLED=postgres://nominara_app:nominara_app_dev_local@localhost:6432/nominara

# STORY-014 — WebAuthn relying party. Never hardcoded in app code; a
# credential minted against one environment's rpID/origin must fail
# verification against another's.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Nominara
WEBAUTHN_ORIGIN=http://localhost:3000

# STORY-014 — access token EdDSA (Ed25519) signing keypair, base64 DER
# (PKCS8 private / SPKI public), verified with `jose`'s jwtVerify. The values
# below are an obvious, non-functional placeholder — never a real keypair
# checked into source control. Generate your own local dev pair with:
#   node -e "const {generateKeyPairSync}=require('node:crypto'); \
#     const {privateKey,publicKey}=generateKeyPairSync('ed25519'); \
#     console.log('AUTH_TOKEN_ED25519_PRIVATE_KEY='+privateKey.export({type:'pkcs8',format:'der'}).toString('base64')); \
#     console.log('AUTH_TOKEN_ED25519_PUBLIC_KEY='+publicKey.export({type:'spki',format:'der'}).toString('base64'));"
AUTH_TOKEN_ED25519_PRIVATE_KEY=REPLACE_WITH_YOUR_OWN_BASE64_DER_PKCS8_ED25519_PRIVATE_KEY
AUTH_TOKEN_ED25519_PUBLIC_KEY=REPLACE_WITH_YOUR_OWN_BASE64_DER_SPKI_ED25519_PUBLIC_KEY

# STORY-017 — kid identifying the current signing key above (`jose`'s
# GetKeyFunction resolver picks the right public key by this value, read from
# the JWS protected header). The previous key/kid pair is optional — set both
# only during a rotation's overlap window, so a token signed with the
# previous key still verifies for its remaining lifetime.
AUTH_TOKEN_ED25519_KID=dev-2026-08
# AUTH_TOKEN_ED25519_PREVIOUS_PUBLIC_KEY=REPLACE_WITH_PREVIOUS_BASE64_DER_SPKI_ED25519_PUBLIC_KEY
# AUTH_TOKEN_ED25519_PREVIOUS_KID=REPLACE_WITH_PREVIOUS_KID

# STORY-017 — HMAC-SHA256(sid, secret) double-submit CSRF token secret.
CSRF_SECRET=REPLACE_WITH_YOUR_OWN_RANDOM_SECRET

# STORY-026 — the realtime handshake's Origin allow-list, comma-separated.
# Required: SameSite=Lax blocks cross-SITE only, so without this any same-site
# origin (a white-label or marketing subdomain) can open a socket with the
# user's cookies and read the whole event stream. List the origins that may
# open a socket, and nothing else.
REALTIME_ALLOWED_ORIGINS=http://localhost:3000

# STORY-021 — LocalDekProvisioner's wrapping key (AES-256-GCM, node:crypto,
# no KMS). REQUIRED, and the schema refuses anything that does not decode to
# EXACTLY 32 bytes — so this cannot be an arbitrary passphrase. It was missing
# from this file entirely, which meant `cp .env.example .env` produced a
# configuration that could not boot. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
WORKSPACE_DEK_WRAPPING_KEY=REPLACE_WITH_A_BASE64_VALUE_DECODING_TO_EXACTLY_32_BYTES

# STORY-021 — recorded verbatim into workspace_keys.kms_key_arn. Defaults to
# "local:dev"; there is no KMS story yet, so a fabricated ARN would be a lie.
# WORKSPACE_KMS_KEY_ARN=local:dev

# STORY-170 — how long a just-consumed refresh token stays eligible to get
# its successor back instead of being treated as reuse. Optional; defaults
# to 2000 (2s). Values above 5000 (5s) are REJECTED at boot — the process
# refuses to start; they are not clamped. 0 disables the grace window
# entirely. An empty value is treated as unset (the default), not as 0.
# The window lives in the Valkey cache (VALKEY_CACHE_URL) with a TTL equal to
# this value; if the cache is unavailable the window is skipped and reuse
# revokes the session, as the strict rule says.
# REFRESH_TOKEN_GRACE_WINDOW_MS=2000

# STORY-015 — OAuth 2.1 + PKCE (Google, GitHub, Microsoft), via
# `openid-client`. Every provider's CLIENT_ID/CLIENT_SECRET is optional —
# leave a provider's pair unset and it is simply unavailable to start a
# flow; the suite stays green with zero real credentials (tests fake the
# provider at a port boundary, same pattern as STORY-014's WebAuthn mocking).
# GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_YOUR_OWN_GOOGLE_OAUTH_CLIENT_ID
# GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_WITH_YOUR_OWN_GOOGLE_OAUTH_CLIENT_SECRET
# GITHUB_OAUTH_CLIENT_ID=REPLACE_WITH_YOUR_OWN_GITHUB_OAUTH_CLIENT_ID
# GITHUB_OAUTH_CLIENT_SECRET=REPLACE_WITH_YOUR_OWN_GITHUB_OAUTH_CLIENT_SECRET
# MICROSOFT_OAUTH_CLIENT_ID=REPLACE_WITH_YOUR_OWN_MICROSOFT_OAUTH_CLIENT_ID
# MICROSOFT_OAUTH_CLIENT_SECRET=REPLACE_WITH_YOUR_OWN_MICROSOFT_OAUTH_CLIENT_SECRET

# STORY-015 — the base URL each provider's redirect_uri is built from
# (`${OAUTH_REDIRECT_BASE_URL}/auth/oauth/:provider/callback`). Required.
OAUTH_REDIRECT_BASE_URL=http://localhost:4000

# STORY-015 — signs the OAuth state parameter (security-and-tenancy.md §5:
# "signed, single-use, short-lived, and bound to the initiating session").
# A separate secret from CSRF_SECRET on purpose — key separation.
OAUTH_STATE_SECRET=REPLACE_WITH_YOUR_OWN_RANDOM_SECRET

# STORY-016 — email OTP (fallback sign-in). Peppers the rate-limit ledger's
# email hash so DB read access alone cannot dictionary-attack it. A separate
# secret from CSRF_SECRET and OAUTH_STATE_SECRET on purpose — key separation.
OTP_EMAIL_HASH_PEPPER=REPLACE_WITH_YOUR_OWN_RANDOM_SECRET

# STORY-016 — non-secret display string for the delivered email's "from"
# header. Not a real transport yet — the EMAIL_SENDER port's logging adapter
# records delivery metadata only, never the code.
OTP_EMAIL_FROM=Nominara <no-reply@nominara.example>
# STORY-127 — set to exactly "true" to log the one-time code IN PLAINTEXT so
# email-OTP sign-in can be completed locally. Without it the code cannot be
# recovered at all: an 8-digit CSPRNG draw, argon2id-hashed at rest, with no
# email provider wired to deliver it.
#
# Refused outright under NODE_ENV=production — the process will not boot.
# Leave it unset anywhere that is not a developer's own machine.
# OTP_DEV_LOG_CODES=true


# STORY-025 — the Valkey CACHE instance (docker-compose.yml's valkey-cache).
# Token buckets, idempotency records, locks and memoisation live here.
# STORY-030 adds QUEUE_REDIS_URL for BullMQ below, a SEPARATE instance with a
# different eviction policy — never point both at the same server.
VALKEY_CACHE_URL=redis://localhost:6379

# STORY-026 — how many hops in front of this process APPEND to
# X-Forwarded-For. Unset means none, and `request.ip` is the peer address.
# Behind a load balancer that is the BALANCER, so every per-IP rate limit in
# §12 collapses onto one key. Never a boolean: trusting the whole chain lets
# any caller forge a header and land in a fresh bucket.
#
# ⚠ STORY-148 — A RELAYING HOP DOES NOT COUNT. nominara-app forwards the
# chain it received verbatim rather than appending to it, and the socket peer
# already accounts for it, so `browser -> ingress -> nominara-app -> api` is
# 1. Setting 2 there returns whatever the caller prepended. Nothing appending
# in front at all? Leave this UNSET — any value makes a caller-authored
# header authoritative.
# TRUST_PROXY_HOPS=1

# STORY-025 — the cache key namespace. Defaults to NODE_ENV, which cannot
# express a DEPLOYMENT: it is one of development|test|production, so a staging
# environment would run as "production" and share production's idempotency
# records key for key. Set it to something that names the deployment wherever
# two environments could reach one Valkey.
# CACHE_KEY_NAMESPACE=staging

# ---------------------------------------------------------------------------
# docker compose only — NOT read by the application.
#
# Host-side port mappings. Compose interpolates these from this file; the
# container-side ports never move, so service-to-service URLs above are
# unaffected. Override when something else on the machine already holds one
# (5432 in particular is very often taken by an unrelated Postgres, and a
# hard-coded mapping would make the whole stack fail to start because of it).
# POSTGRES_PORT=5432
# PGBOUNCER_PORT=6432
# VALKEY_PORT=6379
# VALKEY_QUEUE_PORT=6380
# API_PORT=3000
# GATEWAY_HOST_PORT=3001

# STORY-030 — the queue instance's dedicated Valkey connection
# (docker-compose.yml's `valkey` service), never the cache instance above.
QUEUE_REDIS_URL=redis://localhost:6380

# STORY-030 — rotating HMAC-SHA256 key signing every tenant-scoped job
# payload (src/lib/queue/signing.ts), base64-encoded, exactly 32 bytes.
# Generate your own local dev key with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# The previous key/kid pair is optional — set both only during a rotation's
# overlap window, so a job signed with the previous key still verifies.
QUEUE_JOB_SIGNING_KEY=REPLACE_WITH_YOUR_OWN_BASE64_32_BYTE_KEY
QUEUE_JOB_SIGNING_KID=dev-2026-08
# QUEUE_JOB_SIGNING_PREVIOUS_KEY=REPLACE_WITH_PREVIOUS_BASE64_32_BYTE_KEY
# QUEUE_JOB_SIGNING_PREVIOUS_KID=REPLACE_WITH_PREVIOUS_KID

# STORY-031 D7 — per-engine token-bucket capacity/refill rate, JSON, one
# entry per engine key (src/lib/engines/contract.ts's EngineKey). Refill
# rates are not documented anywhere in the spec — these are placeholder dev
# values, never a baked-in default in library code.
ENGINE_TOKEN_BUCKETS={"google_aio":{"capacity":10,"refillPerSecond":1},"google_ai_mode":{"capacity":10,"refillPerSecond":1},"perplexity":{"capacity":10,"refillPerSecond":1},"chatgpt":{"capacity":10,"refillPerSecond":1},"gemini":{"capacity":10,"refillPerSecond":1},"claude":{"capacity":10,"refillPerSecond":1}}

# STORY-031 D13 — optional per-engine monthly spend ceiling in USD. Absent
# (as here) disables only the 100% hard stop; 80%/95% alerting still runs.
# NEW-A-4 — a gemini ceiling (USD/month, value per owner decision O9; 100 is a dev placeholder).
# ENGINE_SPEND_CEILINGS_USD={"gemini":100,"chatgpt":500,"claude":250}

# NEW-A-4 — Gemini API key (optional). Absent => gemini stays captureReady=false (honest, not failing).
# GEMINI_API_KEY=REPLACE_WITH_KEY

# NEW-D-2 — Stripe SANDBOX. All optional: unset, the API still boots and every
# Stripe route answers 503 degraded. Never commit real values.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# NEW-E-098b — share-token portal. Both optional: unset, the API boots and the portal answers 503 degraded.
# PORTAL_COOKIE_KEY is 32 random bytes as base64url:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# DATABASE_URL_PORTAL logs in as nominara_portal (a SEPARATE pool from DATABASE_URL_POOLED).
# PORTAL_COOKIE_KEY=REPLACE_WITH_32_RANDOM_BYTES_BASE64URL
# DATABASE_URL_PORTAL=postgres://nominara_portal:...@localhost:6432/nominara
