# The API's own port. 4000, not 3000 — 3000 is the frontend's, and the two run
# side by side in development. The gateway is a SEPARATE process on
# GATEWAY_PORT (3001).
PORT=4000

DATABASE_URL=postgres://nominara:nominara@localhost:5432/nominara

# STORY-010: the pooled connection, through pgBouncer in transaction mode
# (docker/pgbouncer/pgbouncer.ini) on port 6432. Application code (src/api,
# src/gateway, src/workers/*) uses THIS one. DATABASE_URL above (port 5432,
# direct to Postgres) stays the migration/DDL connection and never routes
# through the pooler — migrations need a real session-scoped connection for
# their own transactions, which a transaction-mode pool cannot provide.
DATABASE_URL_POOLED=postgres://nominara_app:nominara_app_dev_local@localhost:6432/nominara

# STORY-014 — WebAuthn relying party. Never hardcoded in app code; a
# credential minted against one environment's rpID/origin must fail
# verification against another's.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Nominara
WEBAUTHN_ORIGIN=http://localhost:3000

# STORY-014 — access token EdDSA (Ed25519) signing keypair, base64 DER
# (PKCS8 private / SPKI public), verified with `jose`'s jwtVerify. The values
# below are an obvious, non-functional placeholder — never a real keypair
# checked into source control. Generate your own local dev pair with:
#   node -e "const {generateKeyPairSync}=require('node:crypto'); \
#     const {privateKey,publicKey}=generateKeyPairSync('ed25519'); \
#     console.log('AUTH_TOKEN_ED25519_PRIVATE_KEY='+privateKey.export({type:'pkcs8',format:'der'}).toString('base64')); \
#     console.log('AUTH_TOKEN_ED25519_PUBLIC_KEY='+publicKey.export({type:'spki',format:'der'}).toString('base64'));"
AUTH_TOKEN_ED25519_PRIVATE_KEY=REPLACE_WITH_YOUR_OWN_BASE64_DER_PKCS8_ED25519_PRIVATE_KEY
AUTH_TOKEN_ED25519_PUBLIC_KEY=REPLACE_WITH_YOUR_OWN_BASE64_DER_SPKI_ED25519_PUBLIC_KEY

# STORY-017 — kid identifying the current signing key above (`jose`'s
# GetKeyFunction resolver picks the right public key by this value, read from
# the JWS protected header). The previous key/kid pair is optional — set both
# only during a rotation's overlap window, so a token signed with the
# previous key still verifies for its remaining lifetime.
AUTH_TOKEN_ED25519_KID=dev-2026-08
# AUTH_TOKEN_ED25519_PREVIOUS_PUBLIC_KEY=REPLACE_WITH_PREVIOUS_BASE64_DER_SPKI_ED25519_PUBLIC_KEY
# AUTH_TOKEN_ED25519_PREVIOUS_KID=REPLACE_WITH_PREVIOUS_KID

# STORY-017 — HMAC-SHA256(sid, secret) double-submit CSRF token secret.
CSRF_SECRET=REPLACE_WITH_YOUR_OWN_RANDOM_SECRET

# STORY-026 — the realtime handshake's Origin allow-list, comma-separated.
# Required: SameSite=Lax blocks cross-SITE only, so without this any same-site
# origin (a white-label or marketing subdomain) can open a socket with the
# user's cookies and read the whole event stream. List the origins that may
# open a socket, and nothing else.
REALTIME_ALLOWED_ORIGINS=http://localhost:3000

# STORY-021 — LocalDekProvisioner's wrapping key (AES-256-GCM, node:crypto,
# no KMS). REQUIRED, and the schema refuses anything that does not decode to
# EXACTLY 32 bytes — so this cannot be an arbitrary passphrase. It was missing
# from this file entirely, which meant `cp .env.example .env` produced a
# configuration that could not boot. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
WORKSPACE_DEK_WRAPPING_KEY=REPLACE_WITH_A_BASE64_VALUE_DECODING_TO_EXACTLY_32_BYTES

# STORY-021 — recorded verbatim into workspace_keys.kms_key_arn. Defaults to
# "local:dev"; there is no KMS story yet, so a fabricated ARN would be a lie.
# WORKSPACE_KMS_KEY_ARN=local:dev

# STORY-170 — how long a just-consumed refresh token stays eligible to get
# its successor back instead of being treated as reuse. Optional; defaults
# to 2000 (2s). Values above 5000 (5s) are REJECTED at boot — the process
# refuses to start; they are not clamped. 0 disables the grace window
# entirely. An empty value is treated as unset (the default), not as 0.
# The window lives in the Valkey cache (VALKEY_CACHE_URL) with a TTL equal to
# this value; if the cache is unavailable the window is skipped and reuse
# revokes the session, as the strict rule says.
# REFRESH_TOKEN_GRACE_WINDOW_MS=2000

# STORY-015 — OAuth 2.1 + PKCE (Google, GitHub, Microsoft), via
# `openid-client`. Every provider's CLIENT_ID/CLIENT_SECRET is optional —
# leave a provider's pair unset and it is simply unavailable to start a
# flow; the suite stays green with zero real credentials (tests fake the
# provider at a port boundary, same pattern as STORY-014's WebAuthn mocking).
# GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_YOUR_OWN_GOOGLE_OAUTH_CLIENT_ID
# GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_WITH_YOUR_OWN_GOOGLE_OAUTH_CLIENT_SECRET
# GITHUB_OAUTH_CLIENT_ID=REPLACE_WITH_YOUR_OWN_GITHUB_OAUTH_CLIENT_ID
# GITHUB_OAUTH_CLIENT_SECRET=REPLACE_WITH_YOUR_OWN_GITHUB_OAUTH_CLIENT_SECRET
# MICROSOFT_OAUTH_CLIENT_ID=REPLACE_WITH_YOUR_OWN_MICROSOFT_OAUTH_CLIENT_ID
# MICROSOFT_OAUTH_CLIENT_SECRET=REPLACE_WITH_YOUR_OWN_MICROSOFT_OAUTH_CLIENT_SECRET

# STORY-015 — the base URL each provider's redirect_uri is built from
# (`${OAUTH_REDIRECT_BASE_URL}/auth/oauth/:provider/callback`). Required.
OAUTH_REDIRECT_BASE_URL=http://localhost:4000

# STORY-015 — signs the OAuth state parameter (security-and-tenancy.md §5:
# "signed, single-use, short-lived, and bound to the initiating session").
# A separate secret from CSRF_SECRET on purpose — key separation.
OAUTH_STATE_SECRET=REPLACE_WITH_YOUR_OWN_RANDOM_SECRET

# STORY-016 — email OTP (fallback sign-in). Peppers the rate-limit ledger's
# email hash so DB read access alone cannot dictionary-attack it. A separate
# secret from CSRF_SECRET and OAUTH_STATE_SECRET on purpose — key separation.
OTP_EMAIL_HASH_PEPPER=REPLACE_WITH_YOUR_OWN_RANDOM_SECRET

# STORY-016 — non-secret display string for the delivered email's "from"
# header. Not a real transport yet — the EMAIL_SENDER port's logging adapter
# records delivery metadata only, never the code.
OTP_EMAIL_FROM=Nominara <no-reply@nominara.example>
# STORY-127 — set to exactly "true" to log the one-time code IN PLAINTEXT so
# email-OTP sign-in can be completed locally. Without it the code cannot be
# recovered at all: an 8-digit CSPRNG draw, argon2id-hashed at rest, with no
# email provider wired to deliver it.
#
# Refused outright under NODE_ENV=production — the process will not boot.
# Leave it unset anywhere that is not a developer's own machine.
# OTP_DEV_LOG_CODES=true

# Group C — real email through Resend (https://resend.com). When BOTH of these are set, the EMAIL_SENDER port delivers
# through Resend's REST API (OTP codes, auto-top-up notices, scheduled reports, operational alerts). Leave them unset
# to keep today's behaviour (delivery metadata logged, nothing sent). RESEND_FROM_EMAIL is `address` or
# `Display Name <address>` and must be a sender your Resend account may use (Resend's shared test sender, or an address
# on a verified domain). In production the two must be set together or the process will not boot.
# RESEND_API_KEY=re_REPLACE_WITH_YOUR_OWN_KEY
# RESEND_FROM_EMAIL=Nominara <no-reply@nominara.example>
# DEV-ONLY: redirect EVERY outgoing email to this one address. Resend's shared test sender can only deliver to the
# account owner's own address, so set it to that. Refused outright under NODE_ENV=production.
# RESEND_TO_EMAIL=you@example.com
# STORY-178 — the Svix signing secret of the Resend webhook (Resend dashboard > Webhooks > the endpoint's "Signing Secret",
# `whsec_...`), for `POST /v1/webhooks/resend` (bounces and complaints suppress the address). Subscribe the endpoint to
# email.bounced and email.complained. Unset: the route answers 503 and nothing is suppressed. REQUIRED under
# NODE_ENV=production whenever the Resend pair above is set.
# RESEND_WEBHOOK_SECRET=whsec_REPLACE_WITH_THE_ENDPOINT_SECRET
# Where operational alerts are emailed (dead-letter depth, engine blackout, parser alarms, audit-chain and wallet
# mismatches), through the same sender. Unset: alerts are logged and counted only, and boot says so once.
# ALERT_EMAIL_TO=oncall@example.com

# STORY-077 R4 / STORY-013 — set to exactly "true" to let the nightly `retention.purge` job run. It HARD-DELETES
# soft-deleted projects past 30 days and workspaces past their deletion grace, so it is OFF by default and a value other
# than "true" stops the process booting. Leave it unset until an object store, the workspace-export sink, the
# retention-shortening notice and legal hold exist (src/lib/queue/handlers/retention-purge.handler.ts says why).
# RETENTION_PURGE_ENABLED=true


# STORY-025 — the Valkey CACHE instance (docker-compose.yml's valkey-cache).
# Token buckets, idempotency records, locks and memoisation live here.
# STORY-030 adds QUEUE_REDIS_URL for BullMQ below, a SEPARATE instance with a
# different eviction policy — never point both at the same server.
VALKEY_CACHE_URL=redis://localhost:6379

# STORY-026 — how many hops in front of this process APPEND to
# X-Forwarded-For. Unset means none, and `request.ip` is the peer address.
# Behind a load balancer that is the BALANCER, so every per-IP rate limit in
# §12 collapses onto one key. Never a boolean: trusting the whole chain lets
# any caller forge a header and land in a fresh bucket.
#
# ⚠ STORY-148 — A RELAYING HOP DOES NOT COUNT. nominara-app forwards the
# chain it received verbatim rather than appending to it, and the socket peer
# already accounts for it, so `browser -> ingress -> nominara-app -> api` is
# 1. Setting 2 there returns whatever the caller prepended. Nothing appending
# in front at all? Leave this UNSET — any value makes a caller-authored
# header authoritative.
# TRUST_PROXY_HOPS=1

# STORY-024 — tracing. Every request is a server span and its 32-hex trace id is `meta.request_id` (envelope and Problem
# Details), so the id exists with NO collector. The OTLP exporter is wired only when the endpoint below is set: the base
# URL of an OTLP/HTTP collector (`/v1/traces` is appended). Unset = spans are created and dropped.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Head-sampling ratio for new traces, 0..1 (default 1 = always on). A sampled-out request still has a trace id.
# OTEL_TRACES_SAMPLER_ARG=1

# STORY-025 — the cache key namespace. Defaults to NODE_ENV, which cannot
# express a DEPLOYMENT: it is one of development|test|production, so a staging
# environment would run as "production" and share production's idempotency
# records key for key. Set it to something that names the deployment wherever
# two environments could reach one Valkey.
# CACHE_KEY_NAMESPACE=staging

# ---------------------------------------------------------------------------
# docker compose only — NOT read by the application.
#
# Host-side port mappings. Compose interpolates these from this file; the
# container-side ports never move, so service-to-service URLs above are
# unaffected. Override when something else on the machine already holds one
# (5432 in particular is very often taken by an unrelated Postgres, and a
# hard-coded mapping would make the whole stack fail to start because of it).
# POSTGRES_PORT=5432
# PGBOUNCER_PORT=6432
# VALKEY_PORT=6379
# VALKEY_QUEUE_PORT=6380
# API_PORT=4000
# GATEWAY_HOST_PORT=3001
# The api image tag (STORY-004): set it with COMPOSE_PROJECT_NAME when running a second stack on one machine.
# NOMINARA_API_IMAGE=nominara-api

# STORY-030 — the queue instance's dedicated Valkey connection
# (docker-compose.yml's `valkey` service), never the cache instance above.
QUEUE_REDIS_URL=redis://localhost:6380

# STORY-030 — rotating HMAC-SHA256 key signing every tenant-scoped job
# payload (src/lib/queue/signing.ts), base64-encoded, exactly 32 bytes.
# Generate your own local dev key with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# The previous key/kid pair is optional — set both only during a rotation's
# overlap window, so a job signed with the previous key still verifies.
QUEUE_JOB_SIGNING_KEY=REPLACE_WITH_YOUR_OWN_BASE64_32_BYTE_KEY
QUEUE_JOB_SIGNING_KID=dev-2026-08
# QUEUE_JOB_SIGNING_PREVIOUS_KEY=REPLACE_WITH_PREVIOUS_BASE64_32_BYTE_KEY
# QUEUE_JOB_SIGNING_PREVIOUS_KID=REPLACE_WITH_PREVIOUS_KID

# STORY-031 D7 — per-engine token-bucket capacity/refill rate, JSON, one
# entry per engine key (src/lib/engines/contract.ts's EngineKey). Refill
# rates are not documented anywhere in the spec — these are placeholder dev
# values, never a baked-in default in library code.
ENGINE_TOKEN_BUCKETS={"google_aio":{"capacity":10,"refillPerSecond":1},"google_ai_mode":{"capacity":10,"refillPerSecond":1},"perplexity":{"capacity":10,"refillPerSecond":1},"chatgpt":{"capacity":10,"refillPerSecond":1},"gemini":{"capacity":10,"refillPerSecond":1},"claude":{"capacity":10,"refillPerSecond":1}}

# STORY-031 D13 — optional per-engine monthly spend ceiling in USD. An engine
# with no ceiling has NEITHER the 80%/95% alerts NOR the 100% hard stop (spend-meter.ts computes both only when a ceiling exists).
# NEW-A-4 — a gemini ceiling (USD/month, value per owner decision O9; 100 is a dev placeholder).
# E2E-B6: gemini defaults to 100, and google_aio / google_ai_mode to 5 each (STORY-029 placeholders), when this is unset (DEFAULT_ENGINE_SPEND_CEILINGS_USD); an entry
# here overrides it and adds ceilings for other engines.
ENGINE_SPEND_CEILINGS_USD={"gemini":100}

# NEW-A-4 — Gemini API key (optional). Absent => gemini stays captureReady=false (honest, not failing).
# GEMINI_API_KEY=REPLACE_WITH_KEY

# SCANFIX D3 - requests per minute the capture worker may send to Gemini (default 10 = the free tier
# of gemini-2.5-flash). Cells beyond it are delayed in the queue, not failed; a 429 that still gets
# through is deferred by the vendor's Retry-After. Raise it only with the paid quota. It overrides
# ENGINE_TOKEN_BUCKETS.gemini (a one-token bucket refilling at this rate / 60 per second).
GEMINI_REQUESTS_PER_MINUTE=10

# STORY-067 - when a completed task is re-measured. Unset = the documented defaults: +48 hours and +14 days.
# TASK_VERIFICATION_SHORT_HOURS=48
# TASK_VERIFICATION_LONG_DAYS=14

# STORY-029 - SerpApi (serpapi.com) key for the two Google surfaces, google_aio (AI Overviews) and google_ai_mode (AI Mode). Optional.
# Absent => both stay captureReady=false (honest, not failing). Present => both capture for real. The Free plan is 250 searches a month;
# an AI Overview that loads on demand costs TWO searches (the search, then its page_token), AI Mode costs one.
# SERP_API_KEY=REPLACE_WITH_KEY

# STORY-029 - requests per minute the capture worker may send to EACH Google surface (default 1). This paces throughput; it does not bound the monthly quota (the spend ceiling does). Cells beyond it
# are delayed in the queue, not failed. It overrides ENGINE_TOKEN_BUCKETS.google_aio / .google_ai_mode (a one-token bucket refilling at
# this rate / 60 per second). The two surfaces draw separate buckets, so the vendor can see up to twice this. Raise it with the plan.
SERP_REQUESTS_PER_MINUTE=1

# STORY-029 - a monthly spend ceiling (USD) for the Google surfaces is set in ENGINE_SPEND_CEILINGS_USD above, by engine key, e.g.
#   ENGINE_SPEND_CEILINGS_USD={"gemini":100,"google_aio":20,"google_ai_mode":20}
# Defaults of 5 USD each apply when unset (DEFAULT_ENGINE_SPEND_CEILINGS_USD). They are PLACEHOLDERS (owner decision 28, 2026-10-30): once a paid SerpApi plan is bought,
# set each to that plan's monthly cost. (Scale: 250 Free-plan searches at the metered $0.015 is $3.75 across both.)
# The adapter prices a search at the 5,000-a-month plan's list rate ($0.015); the Free plan bills nothing, so the meter over-reads there.

# Owner decisions 41 and 42 (2026-10-30) - OpenRouter (openrouter.ai): ONE key for the chatgpt, claude and perplexity engine adapters, and
# for the free development embeddings. Optional. The key ALONE binds nothing: the three engines stay captureReady=false (honest, not failing)
# unless you opt in below. Never commit the value.
# OPENROUTER_API_KEY=REPLACE_WITH_KEY

# Decision 44 - the PAID path (real GPT / Claude / Perplexity through OpenRouter) is an explicit opt-in, like EMBEDDING_PROVIDER. off (default) =
# the key alone binds no engine. paid = the three engines capture for real and SPEND CREDIT: one native-search capture is about $0.07
# (gpt-5.4), $0.11 (claude-sonnet-5.5), $0.006 (perplexity/sonar). Parked until the client supplies keys / the owner tops up.
# ENGINE_OPENROUTER=off

# Owner decision 42 - the OpenRouter model id behind each engine. PLACEHOLDERS: model tier is a fidelity decision (tracking-engine.md
# section 3), so changing one is a methodology event. A ':free' id is refused for these engines (a free model never serves a tracked engine).
# Defaults: openai/gpt-5.4 · anthropic/claude-sonnet-5.5 · perplexity/sonar (search-native; it must stay a perplexity/sonar* model).
# OPENROUTER_MODEL_CHATGPT=openai/gpt-5.4
# OPENROUTER_MODEL_CLAUDE=anthropic/claude-sonnet-5.5
# OPENROUTER_MODEL_PERPLEXITY=perplexity/sonar

# Owner decision 43 - DEVELOPMENT ONLY simulated engines: `openrouter-free` backs the chatgpt / claude / perplexity slots with FREE OpenRouter
# models (needs OPENROUTER_API_KEY; no credit spent). Every result is stored flagged `simulated` with the free model's id (model_fingerprint),
# so the UI can label it. Refused at boot under NODE_ENV=production, and again by the registry and the adapter. Unset/off = no simulation (the paid path still needs ENGINE_OPENROUTER=paid).
# ENGINE_SIMULATION=openrouter-free
# OPENROUTER_SIMULATED_MODEL_CHATGPT=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_SIMULATED_MODEL_CLAUDE=google/gemma-4-31b-it:free
# OPENROUTER_SIMULATED_MODEL_PERPLEXITY=nvidia/nemotron-3.5-super-vl:free

# Owner decision 42 - requests per minute the capture worker may send to EACH of chatgpt / claude / perplexity (default 10). Cells beyond it
# are delayed in the queue, not failed. Overrides ENGINE_TOKEN_BUCKETS for those three. Spend ceilings default to 4 / 4 / 1 USD (placeholders pending the owner, total 9 inside the 10 USD key limit,
# DEFAULT_ENGINE_SPEND_CEILINGS_USD) and are set per engine key in ENGINE_SPEND_CEILINGS_USD above.
OPENROUTER_REQUESTS_PER_MINUTE=10

# Owner decision 41 - which embedding provider runs: auto (default: OPENAI_API_KEY ? OpenAI : the deterministic stand-in, refusing in
# production) | stand-in | openrouter | openai. `openrouter` = the FREE nvidia/nemotron-3.5-embed-1b:free at 1536 dimensions, DEVELOPMENT ONLY
# (free providers may log input; refused under NODE_ENV=production). Having OPENROUTER_API_KEY never selects it by itself. Vectors are stored
# with embedding_model = nvidia/nemotron-3.5-embed-1b:free, so switching model later re-embeds. Switching also means re-checking the cosine
# thresholds (0.82 cluster, 0.93 dedupe, 0.90 presence), which were set for text-embedding-3-large.
EMBEDDING_PROVIDER=auto

# Owner decision 41 - requests per minute to the free embedding tier (default 10; the vendor allows 20, plus a daily cap of 50 free-model
# requests on an account with no credit). Calls queue behind this pace rather than failing.
OPENROUTER_EMBED_REQUESTS_PER_MINUTE=10

# STORY-045 — which model naturalises generated prompt text. `none` (default) = template-only, deterministic, no model call.
# `gemini` uses GEMINI_API_KEY above with the Flash-class model below; without a key it falls back to template-only.
# Held off the request path until STORY-045 decision #5 (ADR-0003: the generate route's transaction is open): `gemini` is logged at boot and ignored.
PROMPT_NATURALISER=none
PROMPT_NATURALISER_MODEL=gemini-2.5-flash
PROMPT_NATURALISER_TIMEOUT_MS=8000

# STORY-191 (owner decision 99c) - which model judges brand-name matches the v1 case heuristic cannot settle (A2 disambiguation risk). `none` (default)
# keeps the heuristic as the judge, and no Entity Authority score is published while it is (owner decision 17). `gemini` uses GEMINI_API_KEY above with
# the Flash-class model below; without a key it falls back to the heuristic. Runs in the geo.analyze job, outside any transaction, on the gemini bucket.
NAME_MATCH_JUDGE=none
NAME_MATCH_JUDGE_MODEL=gemini-2.5-flash
NAME_MATCH_JUDGE_TIMEOUT_MS=8000

# STORY-060 E1/E3 (owner decision 99b) - the Wikidata and Wikipedia profile probe (the entity_probe job, on geo.analyze). `wikimedia` (default) checks each
# project's two profiles at most weekly through the SSRF guard, robots.txt and a per-host budget; `none` switches it off. The other five nodes are not
# probed, so the Entity Authority score stays withheld either way.
ENTITY_PROFILE_PROBE=wikimedia

# NEW-D-2 — Stripe SANDBOX. All optional: unset, the API still boots and every
# Stripe route answers 503 degraded. Never commit real values.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# NEW-E-098b — share-token portal. Both optional: unset, the API boots and the portal answers 503 degraded.
# PORTAL_COOKIE_KEY is 32 random bytes as base64url:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# DATABASE_URL_PORTAL logs in as nominara_portal (a SEPARATE pool from DATABASE_URL_POOLED).
# PORTAL_COOKIE_KEY=REPLACE_WITH_32_RANDOM_BYTES_BASE64URL
# DATABASE_URL_PORTAL=postgres://nominara_portal:...@localhost:6432/nominara

# Group C item 3 - object storage (KAD-08), S3-compatible. All optional: unset, the API boots and every storage call
# answers 503 degraded. LocalStack (docker-compose.yml `localstack`, host port 4566) in development; in production only
# the endpoint and credentials change: leave STORAGE_ENDPOINT, STORAGE_FORCE_PATH_STYLE and the two ACCESS values UNSET
# on AWS (the IAM role supplies credentials) and set STORAGE_SSE to aws:kms (the spec's SSE-KMS; the default when unset).
# The two bucket names switch storage on and must be set together. LocalStack's init script creates them locally.
# LocalStack is an OPT-IN compose profile (image pinned by digest): `docker compose --profile storage up -d localstack`;
# a plain `docker compose up` neither pulls it nor binds 4566.
# NODE_ENV=production additionally REQUIRES STORAGE_KMS_KEY_ID (unless STORAGE_SSE=AES256) and STORAGE_KEY_ENV, and
# STORAGE_KEY_ENV=crawl is reserved (refused).
# NOTE: a compose service reaches LocalStack at http://localstack:4566, not localhost; override STORAGE_ENDPOINT in that
# service's `environment` when the first consumer of storage lands.
# STORAGE_ENDPOINT=http://localhost:4566
# STORAGE_REGION=us-east-1
# STORAGE_BUCKET_RAW=nominara-raw
# STORAGE_BUCKET_REPORTS=nominara-reports
# STORAGE_ACCESS_KEY_ID=test
# STORAGE_SECRET_ACCESS_KEY=test
# STORAGE_FORCE_PATH_STYLE=true
# STORAGE_SSE=AES256
# STORAGE_KMS_KEY_ID=REPLACE_WITH_KMS_KEY_ID_OR_ARN
# STORAGE_KEY_ENV=dev
